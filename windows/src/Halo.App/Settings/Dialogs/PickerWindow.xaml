<Window x:Class="Halo.App.Settings.Dialogs.PickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="{Binding Title}" Width="540" Height="620" MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel Margin="16">
    <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,0,12"
             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
             AutomationProperties.Name="Search" AutomationProperties.HelpText="Type to filter the list; arrow keys move the selection."
             PreviewKeyDown="OnSearchKeyDown" />
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Choose" IsDefault="True" Click="OnChoose" MinWidth="96" Margin="0,0,8,0" Style="{DynamicResource AccentButtonStyle}" />
      <Button Content="Cancel" IsCancel="True" MinWidth="96" />
    </StackPanel>
    <ListBox x:Name="List" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
             MouseDoubleClick="OnChoose" AutomationProperties.Name="Choices"
             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.GroupStyle>
        <GroupStyle>
          <GroupStyle.HeaderTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="4,12,0,4" Opacity="0.8" />
            </DataTemplate>
          </GroupStyle.HeaderTemplate>
        </GroupStyle>
      </ListBox.GroupStyle>
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
          <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
          <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid Margin="2,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="32" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Glyph" Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                       VerticalAlignment="Center" HorizontalAlignment="Center" />
            <Image x:Name="Icon" Source="{Binding Icon}" Width="24" Height="24" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Subtitle}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="Note" Text="{Binding Note}" Opacity="0.8" FontStyle="Italic" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
          <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
              <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Note}" Value="{x:Null}">
              <Setter TargetName="Note" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
