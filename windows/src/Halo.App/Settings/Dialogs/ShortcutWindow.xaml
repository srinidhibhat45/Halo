<Window x:Class="Halo.App.Settings.Dialogs.ShortcutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
  <StackPanel Margin="20">
    <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,0,0,12" />
    <Border BorderThickness="1" CornerRadius="6" Padding="12" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
      <TextBlock x:Name="Combo" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"
                 AutomationProperties.LiveSetting="Assertive" />
    </Border>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="AgainButton" Content="Record Again" Click="OnRecordAgain" IsEnabled="False" MinWidth="110" Margin="0,0,8,0" />
      <Button x:Name="UseButton" Content="Use Shortcut" Click="OnUse" IsEnabled="False" IsDefault="True" MinWidth="110" Margin="0,0,8,0" Style="{DynamicResource AccentButtonStyle}" />
      <Button Content="Cancel" Click="OnCancel" MinWidth="96" />
    </StackPanel>
  </StackPanel>
</Window>
