<Window x:Class="Halo.App.Settings.Dialogs.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Width="520" SizeToContent="Height" MinHeight="180"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
  <StackPanel Margin="20">
    <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,0,0,10" />
    <TextBox x:Name="Input" MinHeight="32" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="OkButton" Content="OK" IsDefault="True" Click="OnOk" MinWidth="96" Margin="0,0,8,0" Style="{DynamicResource AccentButtonStyle}" />
      <Button Content="Cancel" IsCancel="True" MinWidth="96" />
    </StackPanel>
  </StackPanel>
</Window>
