<UserControl x:Class="Halo.App.Settings.Views.AppearancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:ClassModifier="internal">
  <Grid Margin="24,16,24,24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="380" />
      <ColumnDefinition Width="320" />
    </Grid.ColumnDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel Margin="0,0,24,0">
        <TextBlock Text="Appearance" Style="{StaticResource PageTitle}" />

        <TextBlock Text="Theme" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource Card}">
          <ItemsControl ItemsSource="{Binding Themes}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <RadioButton GroupName="Theme" IsChecked="{Binding IsSelected}" Margin="0,4">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Secondary}" />
                  </StackPanel>
                </RadioButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <TextBlock Text="Size and motion" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Text="Ring size" Width="130" VerticalAlignment="Center" />
              <TextBlock DockPanel.Dock="Right" Text="{Binding RingScaleText}" Width="60" TextAlignment="Right" VerticalAlignment="Center" />
              <Slider Minimum="{Binding RingScaleMin}" Maximum="{Binding RingScaleMax}" Value="{Binding RingScale}" SmallChange="0.05" LargeChange="0.1"
                      AutomationProperties.Name="Ring size" />
            </DockPanel>
            <DockPanel Margin="0,12,0,0">
              <TextBlock DockPanel.Dock="Left" Text="Animation speed" Width="130" VerticalAlignment="Center" />
              <TextBlock DockPanel.Dock="Right" Text="{Binding AnimationSpeedText}" Width="60" TextAlignment="Right" VerticalAlignment="Center" />
              <Slider Minimum="0" Maximum="{Binding AnimationSpeedMax}" Value="{Binding AnimationSpeed}" SmallChange="0.1" LargeChange="0.25"
                      AutomationProperties.Name="Animation speed; zero turns animation off" />
            </DockPanel>
            <TextBlock Text="{Binding AnimationNote}" Style="{StaticResource Secondary}" Margin="0,8,0,0" />
          </StackPanel>
        </Border>

        <TextBlock Text="Labels" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <ItemsControl ItemsSource="{Binding LabelModes}" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <RadioButton GroupName="Labels" Content="{Binding Title}" IsChecked="{Binding IsSelected}" Margin="0,0,24,0" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <CheckBox Content="Show slot numbers (press 1–9 and 0 to choose)" IsChecked="{Binding ShowSlotNumbers}" Margin="0,12,0,0" />
          </StackPanel>
        </Border>

        <TextBlock Text="Accent colour" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource Card}">
          <ItemsControl ItemsSource="{Binding Accents}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <RadioButton GroupName="Accent" IsChecked="{Binding IsSelected}" Margin="0,4,16,4" AutomationProperties.Name="{Binding Title}" ToolTip="{Binding Title}">
                  <Ellipse Width="20" Height="20" Fill="{Binding Visual}" />
                </RadioButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Live preview of the Everywhere ring with these settings -->
    <Border Grid.Column="1" x:Name="PreviewHost" CornerRadius="8" VerticalAlignment="Top" Height="320" Margin="0,56,0,0"
            Background="{DynamicResource LayerFillColorDefaultBrush}" AutomationProperties.Name="Preview of the ring" />
  </Grid>
</UserControl>
