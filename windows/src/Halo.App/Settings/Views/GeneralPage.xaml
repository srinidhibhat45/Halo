<UserControl x:Class="Halo.App.Settings.Views.GeneralPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:ClassModifier="internal">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="24,16,32,24" MaxWidth="820" HorizontalAlignment="Left">
      <TextBlock Text="General" Style="{StaticResource PageTitle}" />

      <TextBlock Text="Ring shortcut" Style="{StaticResource SectionHeader}" />
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Button Content="{Binding TriggerText}" Command="{Binding RecordCommand}" MinWidth="220" FontSize="15" Padding="14,8"
                    AutomationProperties.Name="{Binding TriggerAutomationName}" ToolTip="Click, then press the new shortcut. Esc cancels, Backspace clears." />
            <Button Content="Clear" Command="{Binding ClearTriggerCommand}" Margin="12,0,0,0" />
            <Button Content="Restore Default" Command="{Binding RestoreTriggerCommand}" Margin="8,0,0,0" />
          </StackPanel>
          <TextBlock Text="{Binding TriggerMessage}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
          <TextBlock Style="{StaticResource Secondary}" Margin="0,8,0,0"
                     Text="Tip: assign this shortcut to a mouse button in your mouse's software (Logi Options+, Razer Synapse, X-Mouse Button Control…) to open the ring with one thumb. Use a combination apps don't use, such as the default Ctrl+Shift+Alt+H." />
        </StackPanel>
      </Border>

      <TextBlock Text="How the shortcut picks an action" Style="{StaticResource SectionHeader}" />
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <ItemsControl ItemsSource="{Binding SelectionModes}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <RadioButton GroupName="SelectionMode" IsChecked="{Binding IsSelected}" Margin="0,4">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Secondary}" />
                  </StackPanel>
                </RadioButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <DockPanel Margin="0,12,0,0">
            <TextBlock DockPanel.Dock="Left" Text="Hold time" VerticalAlignment="Center" Width="120" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding HoldThresholdText}" VerticalAlignment="Center" Width="60" TextAlignment="Right" />
            <Slider Minimum="{Binding HoldThresholdMin}" Maximum="{Binding HoldThresholdMax}" Value="{Binding HoldThreshold}"
                    SmallChange="0.01" LargeChange="0.05" AutomationProperties.Name="Hold time in seconds"
                    ToolTip="In Automatic mode, holding the shortcut longer than this before letting go counts as a hold." />
          </DockPanel>
        </StackPanel>
      </Border>

      <TextBlock Text="Ring" Style="{StaticResource SectionHeader}" />
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Open the ring" Margin="0,0,0,4" />
          <ItemsControl ItemsSource="{Binding Placements}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <RadioButton GroupName="Placement" Content="{Binding Title}" IsChecked="{Binding IsSelected}" Margin="0,0,24,0" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <CheckBox Content="Close up gaps: show only filled slots, evenly spaced" IsChecked="{Binding ClosesGaps}" Margin="0,12,0,0" />
          <CheckBox Content="Use app rings when their app is in front" IsChecked="{Binding AppRingsEnabled}" Margin="0,8,0,0" />
          <CheckBox Content="Show a confirmation after actions you can't see (copy, media keys)" IsChecked="{Binding ShowConfirmations}" Margin="0,8,0,0" />
        </StackPanel>
      </Border>

      <TextBlock Text="Startup" Style="{StaticResource SectionHeader}" />
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <CheckBox Content="Start Halo when I sign in to Windows" IsChecked="{Binding LaunchAtLogin}" />
          <CheckBox Content="Show Halo in the notification area" IsChecked="{Binding ShowTrayIcon}" Margin="0,8,0,0" />
          <TextBlock Style="{StaticResource Secondary}" FontSize="12" Margin="28,2,0,0" Text="Without the icon, start Halo again from the Start menu to open these settings." />
        </StackPanel>
      </Border>

      <TextBlock Text="Configuration" Style="{StaticResource SectionHeader}" />
      <Border Style="{StaticResource Card}">
        <StackPanel Orientation="Horizontal">
          <Button Content="Import…" Command="{Binding ImportCommand}" Margin="0,0,8,0" />
          <Button Content="Export…" Command="{Binding ExportCommand}" Margin="0,0,8,0" />
          <Button Content="Reset to Defaults…" Command="{Binding ResetCommand}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
